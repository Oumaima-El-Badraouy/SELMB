# Messages « اتصل بنا » (Webapp/contact.html) → data/contact-messages.json
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d
MEMORY_STORE=1
SEED_DEMO=1
# Set to 1 only for local hackathon without JWT (X-Demo-Uid header)
USE_DEMO_AUTH=0

# --- Vercel (serverless) ---
# Le point d’entrée est api/index.js ; vercel.json réécrit tout vers /api.
# MEMORY_STORE=1 écrit sous backend/data/ : sur Vercel le disque est éphémère → données perdues au redémarrage.
# Pour la prod sur Vercel : MEMORY_STORE=0, init Firebase (GOOGLE_APPLICATION_CREDENTIALS ou secret JSON + FIREBASE_PROJECT_ID).
# Contact (JSON) et snapshots mémoire : même limite ; prévoir Firestore ou stockage externe.
# Socket.IO (src/index.js) ne tourne pas sur la fonction serverless ; temps réel = VPS / Railway / Render ou autre Node long-running.
